{
  "name": "jobq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent background job queue on SQLite: priorities, delays, retries with backoff, dead letters, cron schedules, lease-based crash recovery, workers, HTTP API and dashboard",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "demo": "tsx src/demo.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": { "node": ">=22.13" }
}
